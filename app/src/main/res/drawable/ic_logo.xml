<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Fondo Squircle Oscuro Premium (Dark Navy) -->
    <path
        android:pathData="M24,12 H84 A12,12 0 0,1 96,24 V84 A12,12 0 0,1 84,96 H24 A12,12 0 0,1 12,84 V24 A12,12 0 0,1 24,12 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="12"
                android:startY="12"
                android:endX="96"
                android:endY="96"
                android:type="linear">
                <item android:color="#0B0F19" android:offset="0.0" />
                <item android:color="#1B2436" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Escudo / Marco Geométrico de Alta Precision -->
    <path
        android:pathData="M54,20 L84,35 L84,73 L54,88 L24,73 L24,35 Z"
        android:fillColor="#00000000"
        android:strokeColor="#1E3A8A"
        android:strokeWidth="1.5" />

    <path
        android:pathData="M54,20 L84,35 L84,73 L54,88 L24,73 L24,35 Z"
        android:fillColor="#00000000"
        android:strokeColor="#38BDF8"
        android:strokeWidth="0.8" />

    <!-- Monograma "M" Deportivo (Gradiente Cyan a Indigo) -->
    <path
        android:pathData="M32,70 L40,36 L48,36 L54,52 L60,36 L68,36 L76,70 L67,70 L62,48 L56,66 L52,66 L46,48 L41,70 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="36"
                android:endX="76"
                android:endY="70"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#818CF8" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Trazo inferior dinámico (Línea de asfalto / velocidad) -->
    <path
        android:pathData="M30,76 L78,76"
        android:strokeColor="#38BDF8"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

    <path
        android:pathData="M44,81 L64,81"
        android:strokeColor="#818CF8"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
</vector>